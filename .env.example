# === MCP Server Config ===
# API Key for authenticating MCP clients (leave empty to disable auth)
MCP_API_KEY=your_secure_api_key_here
MCP_HOST=0.0.0.0
MCP_PORT=8000

# === Data Source API Keys ===
# Alpha Vantage API Key (free tier: 25 requests/day)
ALPHAVANTAGE_API_KEY=your_alphavantage_key_here

# IDX API (if available)
IDX_API_KEY=your_idx_api_key_here

# Ajaib API (if available)
AJAIB_API_KEY=your_ajaib_api_key_here
